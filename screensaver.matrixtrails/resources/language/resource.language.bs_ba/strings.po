msgctxt "Addon Summary"
msgid "Matrix trails screensaver"
msgstr "Čuvar ekrana za tragove Matrixa"

msgctxt "Addon Description"
msgid "The \"digital rain\" effect, as seen on the computer monitors in \"The Matrix\".[CR][CR]In its settings you can also define your own colors and sizes of rain."
msgstr "Efekat \"digitalne kiše\", kakav se vidi na monitorima računara u filmu \"Matrix\".[CR][CR]U postavkama možete definirati i vlastite boje i veličine kiše."

#. Slider to select amount of colums
msgctxt "#30000"
msgid "Number of columns"
msgstr "Broj kolona"

#. Slider to select amount of colums
msgctxt "#30001"
msgid "Number of rows"
msgstr "Broj redova"

#. Spin to select speed
msgctxt "#30002"
msgid "Speed"
msgstr "Brzina"

#. Multiply value of selected speed
msgctxt "#30003"
msgid "{0:d}x"
msgstr "{0:d}x"

#. Slider help to select amount of colums on 30000
msgctxt "#30004"
msgid "Number of columns to show on screen."
msgstr "Broj kolona za prikaz na ekranu."

#. Slider help to select amount of colums on 30001
msgctxt "#30005"
msgid "Number of rows to show on screen."
msgstr "Broj redova za prikaz na ekranu."

#. Spin help to select speed on 30002
msgctxt "#30006"
msgid "Accelerate how fast lines move down."
msgstr "Ubrzajte brzinu kretanja linija prema dolje."

